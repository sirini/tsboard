# TSBOARD 1.3.0 / GOAPI 1.3.0
# Copy this file to .env, then replace every value marked "change-me".

# HTTP server
GOAPI_VERSION=1.3.0
GOAPI_BASE=goapi
GOAPI_HOST=127.0.0.1
GOAPI_PORT=3003
GOAPI_DOMAIN=https://tsboard.dev
GOAPI_TITLE=TSBOARD

# Uploaded files stay outside the replaceable frontend build.
NUBO_UPLOAD_DIR=./upload
GOAPI_PROFILE_SIZE=256
GOAPI_CONTENT_INSERT_SIZE=640
GOAPI_THUMBNAIL_SIZE=512
GOAPI_FULL_SIZE=2400
GOAPI_FILE_SIZE_LIMIT=104857600

# MySQL / MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=tsboard
DB_PASS=change-me
DB_NAME=tsboard
DB_TABLE_PREFIX=tsboard_
DB_UNIX_SOCKET=
DB_MAX_IDLE=10
DB_MAX_OPEN=10

# Generate two different random values. Never commit the real secrets.
JWT_SECRET_KEY=change-me
SYNC_SECRET_KEY=change-me
JWT_ACCESS_HOURS=1
JWT_REFRESH_DAYS=30

# Initial administrator, used only while bootstrapping an empty database.
ADMIN_ID=admin@example.com
ADMIN_PW=change-me

# Resend email and signup policy: verified_email | invite_only | disabled
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_FROM_NAME=TSBOARD
RESEND_REPLY_TO_EMAIL=
SIGNUP_MODE=verified_email

# Optional OAuth providers
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_SECRET=
OAUTH_GOOGLE_ANDROID_CLIENT_ID=
OAUTH_NAVER_CLIENT_ID=
OAUTH_NAVER_SECRET=
OAUTH_KAKAO_CLIENT_ID=
OAUTH_KAKAO_SECRET=

# Optional automatic image descriptions
OPENAI_API_KEY=
OPENAI_IMAGE_DESCRIPTION_ENABLED=false
OPENAI_IMAGE_DESCRIPTION_MODEL=gpt-5.6-luna
OPENAI_IMAGE_DESCRIPTION_MAX_PER_POST=3
OPENAI_IMAGE_DESCRIPTION_CONCURRENCY=1

# Optional Android push notifications (the SPA does not require these).
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_FILE=
